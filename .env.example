# Secrets for outreach.py. Copy to .env (which is git-ignored) and fill in:
#   cp .env.example .env
# outreach.py auto-loads .env — no need to `source` it. NEVER commit .env.

# Hunter.io — resolves a name + company domain into an email address.
# Get a key (free tier ~50 searches/mo): https://hunter.io/api-keys
HUNTER_API_KEY=

# Serper.dev — Google web search as JSON, used by `--search-people` to find the
# right recruiter/hiring manager via public LinkedIn profiles.
# (Google's own Custom Search JSON API is closed to new projects, so we use this.)
# Sign up for free credits at https://serper.dev, then copy your API key.
SERPER_API_KEY=
